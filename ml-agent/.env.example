# 悬浮小精灵 环境变量示例
# 复制为 .env 后填入真实值。.env 已在根 .gitignore 中忽略，切勿提交。
#   cp .env.example .env

# ==================== 大模型（对话）====================
# DeepSeek 走 OpenAI 兼容协议，在 https://platform.deepseek.com 申请
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 温度越低回答越稳定，答疑场景不需要发散
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024
# 单次问答的整体超时（秒）。模型要串几轮工具调用，别设太短
LLM_TIMEOUT=60

# ==================== Embedding（向量化）====================
# DeepSeek 不提供 embedding 接口，故向量化单独用阿里云百炼（有免费额度）
# 在 https://bailian.console.aliyun.com 申请，格式同为 sk- 开头
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMBEDDING_MODEL=text-embedding-v3

# ==================== Java 网关 ====================
# 小精灵不直连 MySQL / ES，一律回调 Java 网关，复用后端全部业务规则
# 与 ml-miniapp/utils/const.js 里的 GATEWAY_HOST 保持一致
GATEWAY_BASE_URL=http://192.168.211.132:24101
GATEWAY_TIMEOUT=10

# ==================== Redis（解析登录身份）====================
# 复用现有 6379 普通 Redis：读 login:token:{uuid} 拿真实 userId
# 注意这不是向量库，向量库是本地 Chroma，不需要 Redis Stack
REDIS_HOST=192.168.211.132
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ==================== 本服务 ====================
AGENT_HOST=0.0.0.0
AGENT_PORT=24107
LOG_LEVEL=INFO

# ==================== RAG ====================
# 知识库源文档目录（放 md / txt / pdf / docx），相对 ml-agent/ 根目录
KNOWLEDGE_DIR=knowledge
# Chroma 持久化目录，由 scripts/ingest.py 生成，已 gitignore
VECTOR_STORE_DIR=data/vectorstore
VECTOR_COLLECTION=ml_knowledge
# 切片粒度：中文课程文档 500/80 比较合适
CHUNK_SIZE=500
CHUNK_OVERLAP=80
# 每次检索召回的片段数
RETRIEVE_TOP_K=4
